PORT=3000
HOST=127.0.0.1

# Required for POST /api/admin/sync. Generate a long random string.
# Do not commit the real value.
ADMIN_KEY=change-me

# WeChat Mini Program credentials (DO NOT commit real values)
WECHAT_APPID=
WECHAT_SECRET=

# JWT secret for session tokens (generate a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# SMTP configuration for email notifications (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# On a China VPS, use the local Nginx proxy instead of the overseas API:
HEROES_PROFILE_BASE=https://api.fao13578.cn/openApi
# HEROES_PROFILE_BASE=https://api.heroesprofile.com/openApi
JSDELIVR_HERO_BASE=https://cdn.jsdelivr.net/gh/heroespatchnotes/heroes-talents@master/hero
